//+------------------------------------------------------------------+
//| AITraderKeys.mqh - API keys compiled into AITraderEA.ex5          |
//|                                                                  |
//| Put this file next to AITraderEA.mq5 in MQL5\Experts, paste your |
//| keys between the quotes, and compile AITraderEA.mq5 (F7).        |
//| The keys end up inside the .ex5, which is what the MQL5 VPS      |
//| receives - they are never printed in the terminal or VPS log.    |
//|                                                                  |
//| Leave a key as "" to fall back to the key file in               |
//| <Common>\Files (PC only).                                        |
//| NEVER commit this file with real keys or share the .ex5.        |
//+------------------------------------------------------------------+
#define AITRADER_KEY_ASAI       ""
#define AITRADER_KEY_DEEPSEEK   ""
#define AITRADER_KEY_OPENROUTER ""
